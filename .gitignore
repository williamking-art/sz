# dsh 通用构建/运行产物（根锚定）
/node_modules/
/lib/
/dist-exe/
/.pnpm-store/
/.cache/
/tmp/
/.worktrees/
/worktrees/
# --- 顶层意外生成的空 lock(前端 lock 在 game/frontend/) ---
/package-lock.json

# --- 本仓库自身的行尾策略文件(dsh 忽略规则的例外) ---
!.gitattributes

