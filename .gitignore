/.editorconfig
/.gitattributes
/.gitlab-ci.yml
/.jscpd.json
/.oxlintrc.json
/.oxlintrc.staged.json
/.rgignore
/AGENTS.md
/BENCHMARK.md
/BRAND_GUIDELINES.i18n.yaml
/BRAND_GUIDELINES.md
/BRAND_GUIDELINES.zh.md
/CLAUDE.md
/CLAUDE.local.md
/CONTRIBUTING.i18n.yaml
/CONTRIBUTING.md
