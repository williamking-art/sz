# ===== 宋祚 (Songzuo) 仓库忽略规则 =====
# 依据 game/README.md 分层规范：dev/ 与 _scratch/ 不参与版本管理

# --- 运行时生成的存档 ---
game/saves/*
!game/saves/.gitkeep

# --- 临时归档与构建产物 (_scratch/) ---
game/_scratch/
_dev_tools/songzuo-game-studio/_scratch/

# --- 密钥与本地配置（绝不入库） ---
game/ai_config.json
**/ai_config.json
*.env
.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- 构建缓存 / 打包产物 ---
build/
dist/
*.exe
*.spec
game/build/
game/dist/
# PyInstaller 目录模式分发产物（含 _internal/ 系统 DLL，均不参与版本管理）
game/SongZuo/

# --- 日志 ---
*.log
game/*.log

# --- 运行产物 / 快捷方式（不入版） ---
songzuo_server/run*.out
songzuo_server/run*.err
songzuo_server/deploy.log.err
game/宋祚.exe.lnk

# --- 项目数据目录（CodeBuddy 工作区数据，非源码） ---
.codebuddy/

# --- 操作系统 / 编辑器 ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- 第三方框架 / 包管理器缓存 / 本地工具（未纳入版本管理） ---
deepseek-harness-master/
node_modules/
tools/

# --- Electron 前端构建产物 / 客户端工作区数据 ---
game/frontend/out/
game/frontend/dist/
game/frontend/release/
*.tsbuildinfo
.zcode/

# --- 开发工具（仅专家团目录入库，其余开发脚本不参与版本管理） ---
_dev_tools/*
!_dev_tools/songzuo-game-studio/
!_dev_tools/agnes_gen.py

# --- 临时文件 / 本地辅助脚本 / 压缩包（不入库） ---
*.tmpdir/
_scratch/._*/
game.rar
dsh-market/
_copy_profiles.ps1
_detach_probe.txt
_*_probe.mjs
_restart_helper.mjs
_schedule_restart.mjs

# ===== DeepSeek Harness (dsh) 忽略规则 =====
# 本仓库只托管宋祚（Songzuo）相关代码；dsh（deepseek-harness）内容一律不入库。
# 以下路径全部来自 dsh 仓库，根锚定（/）仅匹配仓库根目录，不影响 game/docs 等宋祚同名目录。

# dsh 顶层目录
/.agents/
/.claude/
/.github/
/apps/
/dsh-app/
/deepseek-harness-master/
/docs/
/examples/
/native/
/packages/
/patches/
/scripts/
/python/
/vendor/
/website/

